{%- style -%}
  .landing-cta-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  .landing-cta__box { max-width:72rem; margin:0 auto; text-align:center; padding:4rem 2rem; border-radius:{{ settings.card_corner_radius | default: 16 }}px; background:rgba(var(--color-foreground),.04); }
  .landing-cta__icon { color:rgb(var(--color-button)); margin-bottom:1.2rem; }
  .landing-cta__title { margin:0 0 1rem; }
  .landing-cta__text { opacity:.85; line-height:1.6; max-width:56rem; margin:0 auto 2.4rem; }
  .landing-cta__btn { min-width:26rem; }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="landing-cta-{{ section.id }} page-width">
    <div class="landing-cta__box">
      <div class="landing-cta__icon">{% render 'landing-icon', icon: section.settings.icon, size: 48 %}</div>
      {%- if section.settings.heading != blank -%}<h2 class="landing-cta__title title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="landing-cta__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      <button type="button" class="landing-cta__btn button button--primary" data-landing-scroll>{{ section.settings.button_label | escape }}</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-landing-scroll]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = document.querySelector('product-form') || document.querySelector('#MainProduct') || document.querySelector('.product');
      if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    });
  });
</script>

{% schema %}
{
  "name": "Landing · Garantía + CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "icon", "label": "Icono", "default": "shield",
      "options": [{"value":"shield","label":"Escudo"},{"value":"heart","label":"Corazón"},{"value":"paw","label":"Huella"},{"value":"refresh","label":"Devolución"}] },
    { "type": "text", "id": "heading", "label": "Título", "default": "Garantía de mascota feliz — 30 días" },
    { "type": "select", "id": "heading_size", "label": "Tamaño del título", "default": "h1",
      "options": [{"value":"h2","label":"Pequeño"},{"value":"h1","label":"Mediano"},{"value":"h0","label":"Grande"}] },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Pruébala sin riesgo. Si en 30 días tu mascota no está más entretenida y tranquila, te devolvemos el dinero. Sin preguntas." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero la mía ahora" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado superior", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado inferior", "default": 52 }
  ],
  "presets": [ { "name": "Landing · Garantía + CTA" } ]
}
{% endschema %}
