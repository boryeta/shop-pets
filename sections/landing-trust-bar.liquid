{%- style -%}
  .landing-trust-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  .landing-trust__grid { display:grid; grid-template-columns: repeat(2,1fr); gap: 1.2rem 1rem; text-align:center; }
  .landing-trust__item { display:flex; flex-direction:column; align-items:center; gap:.5rem; }
  .landing-trust__item svg { color: rgb(var(--color-foreground)); }
  .landing-trust__text { font-size:1.3rem; line-height:1.3; font-weight:500; }
  @media screen and (min-width:750px){
    .landing-trust-{{ section.id }} { padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px; }
    .landing-trust__grid { grid-template-columns: repeat({{ section.blocks.size }},1fr); }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate">
  <div class="landing-trust-{{ section.id }} page-width">
    <div class="landing-trust__grid">
      {%- for block in section.blocks -%}
        <div class="landing-trust__item" {{ block.shopify_attributes }}>
          {% render 'landing-icon', icon: block.settings.icon, size: 30 %}
          <span class="landing-trust__text">{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing · Barra confianza",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado superior", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado inferior", "default": 24 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ventaja",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "truck",
          "options": [
            {"value":"truck","label":"Camión"},{"value":"shield","label":"Escudo"},{"value":"refresh","label":"Devolución"},
            {"value":"heart","label":"Corazón"},{"value":"paw","label":"Huella"},{"value":"wash","label":"Lavable"},
            {"value":"leaf","label":"Hoja"},{"value":"star","label":"Estrella"},{"value":"clock","label":"Reloj"}
          ]
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Landing · Barra confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Envío gratis" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Pago 100% seguro" } },
        { "type": "item", "settings": { "icon": "refresh", "text": "Devolución en 30 días" } },
        { "type": "item", "settings": { "icon": "paw", "text": "+10.000 mascotas felices" } }
      ]
    }
  ]
}
{% endschema %}
