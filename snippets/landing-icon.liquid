{%- comment -%}
  Renders an inline SVG icon for the conversion landing sections.
  Usage: {% render 'landing-icon', icon: 'paw', size: 32 %}
  Accepts: icon (string key), size (px)
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'paw'
  assign size = size | default: 28
-%}
<span class="landing-icon" style="display:inline-flex;width:{{ size }}px;height:{{ size }}px;" aria-hidden="true">
  {%- case icon -%}
    {%- when 'paw' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M12 14c-2.5 0-4.5 1.7-4.5 3.8 0 1.4 1.2 2.2 2.6 2.2.8 0 1.3-.3 1.9-.3s1.1.3 1.9.3c1.4 0 2.6-.8 2.6-2.2C16.5 15.7 14.5 14 12 14Z" fill="currentColor"/><ellipse cx="6.5" cy="11" rx="1.7" ry="2.2" fill="currentColor"/><ellipse cx="17.5" cy="11" rx="1.7" ry="2.2" fill="currentColor"/><ellipse cx="9.5" cy="7.5" rx="1.6" ry="2.1" fill="currentColor"/><ellipse cx="14.5" cy="7.5" rx="1.6" ry="2.1" fill="currentColor"/></svg>
    {%- when 'brain' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M9 3a3 3 0 0 0-3 3 3 3 0 0 0-2 5.2A3 3 0 0 0 5 17a3 3 0 0 0 4 2.8V3Zm6 0a3 3 0 0 1 3 3 3 3 0 0 1 2 5.2A3 3 0 0 1 19 17a3 3 0 0 1-4 2.8V3Z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
    {%- when 'heart' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M12 20s-7-4.3-7-9.2A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.8C19 15.7 12 20 12 20Z" fill="currentColor"/></svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M12 3l7 2.5v5.5c0 4.5-3 8-7 9.5-4-1.5-7-5-7-9.5V5.5L12 3Z" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M3 6h10v9H3V6Zm10 3h4l3 3v3h-7V9Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.6" fill="currentColor"/><circle cx="17" cy="17.5" r="1.6" fill="currentColor"/></svg>
    {%- when 'clock' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.4"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'leaf' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M5 19c0-8 6-13 14-13 0 8-6 13-14 13Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M5 19c3-4 6-6 10-7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    {%- when 'refresh' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M19 12a7 7 0 1 1-2-4.9M19 4v3.5h-3.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'star' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" width="{{ size }}" height="{{ size }}"><path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.9 6.7 19.6l1-5.8L3.5 9.7l5.9-.9L12 3.5Z"/></svg>
    {%- when 'wash' -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><path d="M6 4h12v16H6z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="13" r="3.2" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="7" r=".8" fill="currentColor"/><circle cx="12" cy="7" r=".8" fill="currentColor"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" width="{{ size }}" height="{{ size }}"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- endcase -%}
</span>
